generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  users users[]
}

model users {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(255)
  password_hash String     @db.VarChar(255)
  role_id       Int?
  first_name    String?    @db.VarChar(100)
  last_name     String?    @db.VarChar(100)
  phone         String?    @db.VarChar(50)
  is_active     Boolean?   @default(true)
  created_at    DateTime?  @default(now())
  role          roles?     @relation(fields: [role_id], references: [id])
  parents       parents?
  employees     employees?
}

model parents {
  id            Int             @id @default(autoincrement())
  user_id       Int?            @unique
  first_name    String          @db.VarChar(100)
  last_name     String          @db.VarChar(100)
  phone         String?         @db.VarChar(50)
  user          users?          @relation(fields: [user_id], references: [id], onDelete: SetNull)
  child_parents child_parents[]
}

model children {
  id             Int              @id @default(autoincrement())
  first_name     String           @db.VarChar(100)
  last_name      String           @db.VarChar(100)
  birth_date     DateTime         @db.Date
  group_id       Int?
  discount_id    Int?             @default(1)
  parent_note    String?          @db.VarChar(500)
  group          groups?          @relation(fields: [group_id], references: [id], onDelete: SetNull)
  discount       discounts?       @relation(fields: [discount_id], references: [id], onDelete: SetNull)
  child_parents  child_parents[]
  child_benefits child_benefits[]
  charges        charges[]
  payments       payments[]
  subscriptions  subscriptions[]
}

model child_parents {
  child_id   Int
  parent_id  Int
  created_at DateTime? @default(now())
  child      children  @relation(fields: [child_id], references: [id], onDelete: Cascade)
  parent     parents   @relation(fields: [parent_id], references: [id], onDelete: Cascade)
  @@id([child_id, parent_id])
}

model groups {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(100)
  target_age        Int
  capacity          Int                 @default(20)
  room_id           Int?                @unique // 2. Унікальна кімната для групи
  created_at        DateTime?           @db.Timestamptz
  room              rooms?              @relation(fields: [room_id], references: [id], onDelete: SetNull)
  children          children[]
  staff_assignments staff_assignments[]
  schedules         schedules[]
}

model rooms {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(100)
  capacity    Int?        @default(15)
  description String?     @db.Text

  groups      groups[]
  schedules   schedules[]
}

model employees {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?                 @unique
  first_name         String               @db.VarChar(100)
  last_name          String               @db.VarChar(100)
  phone              String?              @db.VarChar(50)
  position           String               @db.VarChar(100)
  subject            String?              @db.VarChar(100)
  salary             Decimal              @default(40000.00) @db.Decimal(10, 2)
  user               users?               @relation(fields: [user_id], references: [id], onDelete: Restrict)
  staff_assignments  staff_assignments[]
  teacher_activities teacher_activities[]
  schedules          schedules[]
}

model staff_assignments {
  id          Int        @id @default(autoincrement())
  employee_id Int
  group_id    Int
  role        String?    @db.VarChar(50)
  created_at  DateTime?  @db.Timestamptz
  employee    employees  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  group       groups     @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, group_id])
}

model rules {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)
  base_cost        Decimal  @db.Decimal(10, 2)
  min_children     Int?     @default(12)
  extra_child_cost Decimal? @default(0.00) @db.Decimal(10, 2)
  description      String?  @db.Text
  is_active        Boolean? @default(true)
  created_at       DateTime @default(now())
}

model activities {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(100)
  teacher_activities teacher_activities[]
  schedules          schedules[]
}

model teacher_activities {
  id          Int        @id @default(autoincrement())
  employee_id Int
  activity_id Int
  employee    employees  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  activity    activities @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, activity_id])
}

model schedules {
  id          Int        @id @default(autoincrement())
  group_id    Int
  activity_id Int
  teacher_id  Int
  room_id     Int
  day_of_week String     @db.VarChar(20)
  start_time  DateTime   @db.Time
  end_time    DateTime   @db.Time
  created_at  DateTime?  @db.Timestamptz
  group       groups     @relation(fields: [group_id], references: [id], onDelete: Cascade)
  activity    activities @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  teacher     employees  @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  room        rooms      @relation(fields: [room_id], references: [id], onDelete: Cascade)
}

model discounts {
  id          Int        @id @default(autoincrement())
  code        String     @db.VarChar(50)
  description String?    @db.VarChar(255)
  percent     Decimal    @db.Decimal(5, 2)
  children    children[]
}

model tariffs {
  id         Int      @id @default(autoincrement())
  code       String   @db.VarChar(50)
  amount     Decimal  @db.Decimal(10, 2)
  valid_from DateTime @db.Date
  created_at DateTime @default(now())
}

model meal_rates {
  id         Int      @id @default(autoincrement())
  age        Int
  daily_rate Decimal  @db.Decimal(10, 2)
  valid_from DateTime @db.Date
}

model meal_plans {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
}

model pricing_plans {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)
}

model child_benefits {
  id           Int      @id @default(autoincrement())
  child_id     Int
  benefit_type String   @db.VarChar(255)
  child        children @relation(fields: [child_id], references: [id], onDelete: Cascade)
}

model charges {
  id                 Int           @id @default(autoincrement())
  child_id           Int
  period             DateTime      @db.Date
  base_fee           Decimal       @db.Decimal(10, 2)
  discount_percent   Decimal       @db.Decimal(5, 2)
  tuition_amount     Decimal       @db.Decimal(10, 2)
  meal_price_per_day Decimal       @db.Decimal(10, 2)
  meal_days          Int
  meal_amount        Decimal       @db.Decimal(10, 2)
  total_amount       Decimal       @db.Decimal(10, 2)
  created_at         DateTime      @default(now())
  child              children      @relation(fields: [child_id], references: [id], onDelete: Cascade)
  adjustments        adjustments[]
}

model payments {
  id         Int       @id @default(autoincrement())
  child_id   Int
  amount     Decimal   @db.Decimal(10, 2)
  created_at DateTime  @default(now())

  child      children  @relation(fields: [child_id], references: [id], onDelete: Cascade)
  refunds    refunds[]
}

model refunds {
  id         Int      @id @default(autoincrement())
  payment_id Int
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now())

  payment    payments @relation(fields: [payment_id], references: [id], onDelete: Cascade)
}

model adjustments {
  id         Int      @id @default(autoincrement())
  charge_id  Int
  direction  String   @db.VarChar(50)
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?  @db.VarChar(255)
  created_by Int
  created_at DateTime @default(now())

  charge     charges  @relation(fields: [charge_id], references: [id], onDelete: Cascade)
}

model subscriptions {
  id         Int       @id @default(autoincrement())
  child_id   Int
  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date
  child      children  @relation(fields: [child_id], references: [id], onDelete: Cascade)
}

model expenses {
  id          Int       @id @default(autoincrement())
  category    String    @db.VarChar(100)
  amount      Decimal   @db.Decimal(10, 2)
  description String?   @db.Text
  date        DateTime  @default(now()) @db.Date
  created_at  DateTime? @db.Timestamptz
}