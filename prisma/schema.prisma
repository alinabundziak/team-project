generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model roles {
  id    Int     @id @default(autoincrement())
  name  String  @unique @db.VarChar(50)
  users users[]
}

model users {
  id            Int        @id @default(autoincrement())
  email         String     @unique @db.VarChar(150)
  password_hash String     @db.VarChar(255)
  role_id       Int?
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  employees     employees?
  parents       parents?
  roles         roles?     @relation(fields: [role_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
}

model employees {
  id                 Int                  @id @default(autoincrement())
  user_id            Int?                 @unique
  first_name         String               @db.VarChar(100)
  last_name          String               @db.VarChar(100)
  phone              String?              @db.VarChar(20)
  position           String               @db.VarChar(100)
  salary             Decimal              @default(40000.00) @db.Decimal(10, 2)
  users              users?               @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  groups_assistant   groups[]             @relation("groups_assistant_idToemployees")
  groups_educator    groups[]             @relation("groups_educator_idToemployees")
  schedules          schedules[]
  teacher_activities teacher_activities[]
}

model discounts {
  id         Int        @id @default(autoincrement())
  name       String     @db.VarChar(100)
  percentage Decimal    @default(0.00) @db.Decimal(5, 2)
  children   children[]
  child_benefits child_benefits[]
}

model parents {
  id         Int        @id @default(autoincrement())
  user_id    Int?       @unique
  first_name String     @db.VarChar(100)
  last_name  String     @db.VarChar(100)
  phone      String     @db.VarChar(20)
  is_deputy  Boolean?   @default(false)
  children   children[]
  users      users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model groups {
  id                  Int         @id @default(autoincrement())
  name                String      @db.VarChar(100)
  target_age          Int
  educator_id         Int?
  assistant_id        Int?
  children            children[]
  employees_assistant employees?  @relation("groups_assistant_idToemployees", fields: [assistant_id], references: [id], onUpdate: NoAction)
  employees_educator  employees?  @relation("groups_educator_idToemployees", fields: [educator_id], references: [id], onUpdate: NoAction)
  schedules           schedules[]
}

model children {
  id            Int             @id @default(autoincrement())
  first_name    String          @db.VarChar(100)
  last_name     String          @db.VarChar(100)
  birth_date    DateTime        @db.Date
  group_id      Int?
  parent_id     Int?
  discount_id   Int?            @default(1)
  discounts     discounts?      @relation(fields: [discount_id], references: [id], onUpdate: NoAction)
  groups        groups?         @relation(fields: [group_id], references: [id], onUpdate: NoAction)
  parents       parents?        @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions subscriptions[]
  child_benefits child_benefits[]
  payments       payments[]
}

model meal_plans {
  id            Int     @id @default(autoincrement())
  age_category  Int
  monthly_price Decimal @db.Decimal(10, 2)
}

model subscriptions {
  id                 Int       @id @default(autoincrement())
  child_id           Int?
  payment_type       String?   @db.VarChar(20)
  include_meals      Boolean?  @default(true)
  base_education_fee Decimal?  @default(15000.00) @db.Decimal(10, 2)
  final_amount       Decimal   @db.Decimal(10, 2)
  is_paid            Boolean?  @default(false)
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  children           children? @relation(fields: [child_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model rooms {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(100)
  capacity  Int         @default(15)
  schedules schedules[]
}

model activities {
  id                 Int                  @id @default(autoincrement())
  name               String               @db.VarChar(100)
  schedules          schedules[]
  teacher_activities teacher_activities[]
}

model teacher_activities {
  employee_id Int
  activity_id Int
  activities  activities @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees   employees  @relation(fields: [employee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([employee_id, activity_id])
}

model schedules {
  id          Int         @id @default(autoincrement())
  group_id    Int?
  activity_id Int?
  teacher_id  Int?
  room_id     Int?
  day_of_week Int?
  start_time  DateTime    @db.Time(6)
  end_time    DateTime    @db.Time(6)
  activities  activities? @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  groups      groups?     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rooms       rooms?      @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employees   employees?  @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model rules {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)
  min_children     Int      @default(12) 
  base_cost        Decimal  @db.Decimal(10, 2) 
  extra_child_cost Decimal? @default(0.00) @db.Decimal(10, 2)
  description      String?  @db.Text
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamp(6)
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  CANCELLED
}

model pricing_plans {
  id             Int       @id @default(autoincrement())
  name           String    @db.VarChar(100)
  amount         Decimal   @db.Decimal(10, 2)
  effective_from DateTime  @default(now()) @db.Timestamp(6)
  effective_to   DateTime? @db.Timestamp(6)
  is_active      Boolean   @default(true)
}

model meal_rates {
  id         Int     @id @default(autoincrement())
  age        Int     @unique
  daily_rate Decimal @db.Decimal(10, 2)
}

model child_benefits {
  id             Int        @id @default(autoincrement())
  child_id       Int
  discount_id    Int
  effective_from DateTime   @default(now()) @db.Timestamp(6)
  effective_to   DateTime?  @db.Timestamp(6)
  is_active      Boolean    @default(true)
  
  children       children   @relation(fields: [child_id], references: [id], onDelete: Cascade)
  discounts      discounts  @relation(fields: [discount_id], references: [id], onDelete: Restrict)
}

model payments {
  id                 Int           @id @default(autoincrement())
  child_id           Int
  period             String        @db.VarChar(20) // "YYYY-MM"
  due_date           DateTime      @db.Timestamp(6)
  base_education_fee Decimal       @db.Decimal(10, 2)
  benefit_percentage Decimal       @default(0.00) @db.Decimal(5, 2)
  annual_discount    Decimal       @default(0.00) @db.Decimal(5, 2)
  education_amount   Decimal       @db.Decimal(10, 2)
  meal_amount        Decimal       @db.Decimal(10, 2)
  total_amount       Decimal       @db.Decimal(10, 2)
  paid_amount        Decimal       @default(0.00) @db.Decimal(10, 2)
  status             PaymentStatus @default(PENDING)
  created_at         DateTime      @default(now()) @db.Timestamp(6)

  children           children      @relation(fields: [child_id], references: [id], onDelete: Cascade)
}