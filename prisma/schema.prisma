datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique @db.VarChar(50)
  users User[]

  @@map("roles")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(255)
  password_hash String    @db.VarChar(255)
  role_id       Int?
  first_name    String?   @db.VarChar(100)
  last_name     String?   @db.VarChar(100)
  phone         String?   @db.VarChar(20)
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())

  role          Role?     @relation(fields: [role_id], references: [id])
  parent        Parent?
  employee      Employee?

  @@map("users")
}

model Parent {
  id         Int           @id @default(autoincrement())
  user_id    Int?          @unique
  first_name String        @db.VarChar(100)
  last_name  String        @db.VarChar(100)
  phone      String?       @db.VarChar(20)
  created_at DateTime      @default(now())

  user       User?         @relation(fields: [user_id], references: [id], onDelete: SetNull)
  children   ChildParent[]

  @@map("parents")
}

model Child {
  id             Int            @id @default(autoincrement())
  first_name     String         @db.VarChar(100)
  last_name      String         @db.VarChar(100)
  birth_date     DateTime       @db.Date
  group_id       Int?
  discount_id    Int?           @default(1)
  parent_note    String?        @db.VarChar(255)
  created_at     DateTime       @default(now())

  group          Group?         @relation(fields: [group_id], references: [id], onDelete: SetNull)
  discount       Discount?      @relation(fields: [discount_id], references: [id], onDelete: SetNull)
  parents        ChildParent[]
  child_benefits ChildBenefit[]
  charges        Charge[]
  payments       Payment[]
  subscriptions  Subscription[]

  @@map("children")
}

model ChildParent {
  id         Int      @id @default(autoincrement())
  child_id   Int
  parent_id  Int
  created_at DateTime @default(now())

  child      Child    @relation(fields: [child_id], references: [id], onDelete: Cascade)
  parent     Parent   @relation(fields: [parent_id], references: [id], onDelete: Cascade)

  @@unique([child_id, parent_id])
  @@map("child_parents")
}



model Group {
  id          Int               @id @default(autoincrement())
  name        String            @db.VarChar(100)
  target_age  Int
  capacity    Int               @default(20)
  room_id     Int?
  created_at  DateTime          @default(now())

  room        Room?             @relation(fields: [room_id], references: [id], onDelete: SetNull)
  children    Child[]
  assignments StaffAssignment[]
  schedules   Schedule[]

  @@map("groups")
}

model Room {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  capacity    Int?       @default(15)
  description String?    @db.Text
  created_at  DateTime   @default(now())

  groups      Group[]
  schedules   Schedule[]

  @@map("rooms")
}

model Employee {
  id                 Int               @id @default(autoincrement())
  user_id            Int?              @unique
  first_name         String            @db.VarChar(100)
  last_name          String            @db.VarChar(100)
  phone              String?           @db.VarChar(20)
  position           String            @db.VarChar(100)
  subject            String?           @db.VarChar(100)
  salary             Decimal           @default(40000.00) @db.Decimal(10, 2)
  created_at         DateTime          @default(now())

  user               User?             @relation(fields: [user_id], references: [id], onDelete: SetNull)
  assignments        StaffAssignment[]
  teacher_activities TeacherActivity[]
  schedules          Schedule[]

  @@map("employees")
}

model StaffAssignment {
  id          Int      @id @default(autoincrement())
  employee_id Int
  group_id    Int
  role        String?  @db.VarChar(50)
  created_at  DateTime @default(now())

  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  group       Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)

  @@map("staff_assignments")
}

model Rule {
  id               Int      @id @default(autoincrement())
  name             String   @db.VarChar(100)
  base_cost        Decimal  @db.Decimal(10, 2)
  min_children     Int?     @default(12)
  extra_child_cost Decimal? @default(0.00) @db.Decimal(10, 2)
  description      String?  @db.Text
  is_active        Boolean? @default(true)
  created_at       DateTime @default(now())

  @@map("rules")
}



model Activity {
  id                 Int               @id @default(autoincrement())
  name               String            @db.VarChar(100)
  created_at         DateTime          @default(now())

  teacher_activities TeacherActivity[]
  schedules          Schedule[]

  @@map("activities")
}

model TeacherActivity {
  id          Int      @id @default(autoincrement())
  employee_id Int
  activity_id Int

  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)

  @@unique([employee_id, activity_id])
  @@map("teacher_activities")
}

model Schedule {
  id          Int      @id @default(autoincrement())
  group_id    Int
  activity_id Int
  teacher_id  Int
  room_id     Int
  day_of_week String   @db.VarChar(20)
  start_time  DateTime @db.Time
  end_time    DateTime @db.Time
  created_at  DateTime @default(now())

  group       Group    @relation(fields: [group_id], references: [id], onDelete: Cascade)
  activity    Activity @relation(fields: [activity_id], references: [id], onDelete: Cascade)
  teacher     Employee @relation(fields: [teacher_id], references: [id], onDelete: Cascade)
  room        Room     @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@map("schedules")
}



model Discount {
  id          Int            @id @default(autoincrement())
  code        String         @db.VarChar(50)
  description String?        @db.VarChar(255)
  percent     Decimal        @db.Decimal(5, 2)
  children    Child[]

  @@map("discounts")
}

model Tariff {
  id         Int      @id @default(autoincrement())
  code       String   @db.VarChar(50)
  amount     Decimal  @db.Decimal(10, 2)
  valid_from DateTime @db.Date
  created_at DateTime @default(now())

  @@map("tariffs")
}

model MealRate {
  id         Int      @id @default(autoincrement())
  age        Int
  daily_rate Decimal  @db.Decimal(10, 2)
  valid_from DateTime @db.Date

  @@map("meal_rates")
}

model MealPlan {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)

  @@map("meal_plans")
}

model PricingPlan {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)

  @@map("pricing_plans")
}

model ChildBenefit {
  id           Int    @id @default(autoincrement())
  child_id     Int
  benefit_type String @db.VarChar(255)

  child        Child  @relation(fields: [child_id], references: [id], onDelete: Cascade)

  @@map("child_benefits")
}

model Charge {
  id                 Int          @id @default(autoincrement())
  child_id           Int
  period             DateTime     @db.Date
  base_fee           Decimal      @db.Decimal(10, 2)
  discount_percent   Decimal      @db.Decimal(5, 2)
  tuition_amount     Decimal      @db.Decimal(10, 2)
  meal_price_per_day Decimal      @db.Decimal(10, 2)
  meal_days          Int
  meal_amount        Decimal      @db.Decimal(10, 2)
  total_amount       Decimal      @db.Decimal(10, 2)
  created_at         DateTime     @default(now())

  child              Child        @relation(fields: [child_id], references: [id], onDelete: Cascade)
  adjustments        Adjustment[]

  @@map("charges")
}

model Payment {
  id         Int      @id @default(autoincrement())
  child_id   Int
  amount     Decimal  @db.Decimal(10, 2)
  created_at DateTime @default(now())

  child      Child    @relation(fields: [child_id], references: [id], onDelete: Cascade)
  refunds    Refund[]

  @@map("payments")
}

model Refund {
  id         Int      @id @default(autoincrement())
  payment_id Int
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?  @db.VarChar(255)
  created_at DateTime @default(now())

  payment    Payment  @relation(fields: [payment_id], references: [id], onDelete: Cascade)

  @@map("refunds")
}

model Adjustment {
  id         Int      @id @default(autoincrement())
  charge_id  Int
  direction  String   @db.VarChar(50)
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?  @db.VarChar(255)
  created_by Int
  created_at DateTime @default(now())

  charge     Charge   @relation(fields: [charge_id], references: [id], onDelete: Cascade)

  @@map("adjustments")
}

model Subscription {
  id         Int       @id @default(autoincrement())
  child_id   Int
  start_date DateTime  @db.Date
  end_date   DateTime? @db.Date

  child      Child     @relation(fields: [child_id], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Expense {
  id          Int      @id @default(autoincrement())
  category    String   @db.VarChar(100)
  amount      Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  date        DateTime @default(now()) @db.Date
  created_at  DateTime @default(now())

  @@map("expenses")
}