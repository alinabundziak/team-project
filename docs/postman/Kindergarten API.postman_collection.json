          "name": "01 Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Статус 200', () => pm.response.to.have.status(200));\r\n\r\nconst body = pm.response.json();\r\n\r\npm.test('Є token', () => pm.expect(body.token).to.be.a('string'));\r\npm.test('Хеш пароля не віддається', () => {\r\n  pm.expect(JSON.stringify(body)).to.not.include('password');\r\n});\r\n\r\npm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"admin.test@example.com\",\r\n  \"password\": \"Test12345!\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
