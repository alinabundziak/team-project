{
  "name": "kindergarten-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend starter for Kindergarten Management System using Node.js, Prisma, and Supabase PostgreSQL",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  "engines": {
    "node": ">=18.18"
  },
  "prisma": {
    "seed": "node prisma/users.js"
  }
}
